config_version=5

[application]
config/name="Rowshift"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
undo={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":90)])
}
retry={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":82)])
}

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.94, 0.92, 0.86, 1)
