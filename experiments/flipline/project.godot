config_version=5

[application]
config/name="Flipline"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1440
window/size/window_width_override=360
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
shift_gravity={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":32)])
}
retry={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":82)])
}

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.086, 1)
