config_version=5

[application]
config/name="Filament"
config/description="A living web. Pull it apart. Find your flow."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=720
window/size/viewport_height=1000
window/size/window_width_override=504
window/size/window_height_override=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.964706, 0.94902, 0.921569, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false

[editor]
; Avoid the Godot 4.5 concurrent font-import race (godotengine/godot#111039).
import/use_multiple_threads=false
